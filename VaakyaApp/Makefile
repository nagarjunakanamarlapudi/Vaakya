.PHONY: build run run-stg run-prod clean bundle fresh e2e dev dev-stg

# ============================================================
# Environment URLs
# ============================================================
API_URL_DEV  = http://localhost:8002

# Stg/Prod URLs fetched dynamically from Terraform outputs.
# No hardcoded URLs — if infra is recreated, URLs update automatically.
TF_DIR = ../infra
AWS_PROFILE ?= vaakya-dev

# ============================================================
# Build Config Generation
# ============================================================
define GENERATE_CONFIG
	@mkdir -p Sources/Config
	@echo '// Auto-generated by Makefile. Do not edit manually.' > Sources/Config/BuildConfig.swift
	@echo '// Environment: $(1)' >> Sources/Config/BuildConfig.swift
	@echo 'enum BuildConfig {' >> Sources/Config/BuildConfig.swift
	@echo '    static let environment = "$(1)"' >> Sources/Config/BuildConfig.swift
	@echo '    static let apiBaseURL = "$(2)"' >> Sources/Config/BuildConfig.swift
	@echo '}' >> Sources/Config/BuildConfig.swift
	@echo "[BuildConfig] Generated for $(1) → $(2)"
endef

# ============================================================
# Build
# ============================================================
build:
	swift build

bundle: build
	@echo "Creating Vaakya.app bundle..."
	@rm -rf Vaakya.app
	@mkdir -p Vaakya.app/Contents/MacOS
	@mkdir -p Vaakya.app/Contents/Resources
	@cp .build/debug/Vaakya Vaakya.app/Contents/MacOS/Vaakya
	@cp Sources/Resources/Info.plist Vaakya.app/Contents/Info.plist
	@echo "APPL????" > Vaakya.app/Contents/PkgInfo
	@echo "Vaakya.app created!"

# ============================================================
# Run (per environment)
# ============================================================
run: ## Run in dev mode (localhost API)
	$(call GENERATE_CONFIG,dev,$(API_URL_DEV))
	@$(MAKE) bundle
	@open Vaakya.app

run-stg: ## Run against staging AWS (URL fetched from Terraform)
	$(eval API_URL_STG := $(shell cd $(TF_DIR) && AWS_PROFILE=$(AWS_PROFILE) terraform init -reconfigure -backend-config="key=infra/stg/terraform.tfstate" -backend-config="profile=$(AWS_PROFILE)" > /dev/null 2>&1 && terraform output -raw api_url 2>/dev/null || echo "NOT_DEPLOYED"))
	@if [ "$(API_URL_STG)" = "NOT_DEPLOYED" ]; then \
		echo "ERROR: Staging not deployed. Run 'make backend-setup-stg' first."; \
		exit 1; \
	fi
	@echo "Staging API: $(API_URL_STG)"
	$(call GENERATE_CONFIG,stg,$(API_URL_STG))
	@$(MAKE) bundle
	@open Vaakya.app

run-prod: ## Run against production AWS (URL fetched from Terraform)
	$(eval API_URL_PROD := $(shell cd $(TF_DIR) && AWS_PROFILE=$(AWS_PROFILE) terraform init -reconfigure -backend-config="key=infra/prod/terraform.tfstate" -backend-config="profile=$(AWS_PROFILE)" > /dev/null 2>&1 && terraform output -raw api_url 2>/dev/null || echo "NOT_DEPLOYED"))
	@if [ "$(API_URL_PROD)" = "NOT_DEPLOYED" ]; then \
		echo "ERROR: Production not deployed. Run 'make backend-setup-prod' first."; \
		exit 1; \
	fi
	@echo "Production API: $(API_URL_PROD)"
	$(call GENERATE_CONFIG,prod,$(API_URL_PROD))
	@$(MAKE) bundle
	@open Vaakya.app

fresh: clean run ## Clean build + run (dev)

# ============================================================
# Terminal (with logs visible)
# ============================================================
dev: ## Run from terminal with logs (dev)
	$(call GENERATE_CONFIG,dev,$(API_URL_DEV))
	swift build && .build/debug/Vaakya

dev-stg: ## Run from terminal with logs (stg)
	$(eval API_URL_STG := $(shell cd $(TF_DIR) && AWS_PROFILE=$(AWS_PROFILE) terraform init -reconfigure -backend-config="key=infra/stg/terraform.tfstate" -backend-config="profile=$(AWS_PROFILE)" > /dev/null 2>&1 && terraform output -raw api_url 2>/dev/null))
	@echo "Staging API: $(API_URL_STG)"
	$(call GENERATE_CONFIG,stg,$(API_URL_STG))
	swift build && .build/debug/Vaakya

# ============================================================
# Tests
# ============================================================
e2e:
	swift build
	.build/debug/Vaakya --e2e

# ============================================================
# Xcode (for signing, TestFlight, App Store)
# ============================================================
xcode: ## Open in Xcode for signing and archiving
	open Package.swift

archive: ## Archive for TestFlight (requires Xcode signing setup first)
	xcodebuild archive \
		-scheme Vaakya \
		-destination "generic/platform=macOS" \
		-archivePath build/Vaakya.xcarchive \
		CODE_SIGN_IDENTITY="Apple Distribution" \
		CODE_SIGN_STYLE=Automatic \
		DEVELOPMENT_TEAM=$${DEVELOPMENT_TEAM:?Set DEVELOPMENT_TEAM env var}
	@echo "Archive created at build/Vaakya.xcarchive"
	@echo "Upload to TestFlight: xcodebuild -exportArchive -archivePath build/Vaakya.xcarchive -exportPath build/export -exportOptionsPlist ExportOptions.plist"

# ============================================================
# Clean
# ============================================================
clean:
	swift package clean
	rm -rf Vaakya.app build/
